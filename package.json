{
  "name": "kisa",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "turbo dev --filter=@kisa/backend",
    "dev:frontend": "turbo dev --filter=@kisa/frontend",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db push",
    "db:studio": "turbo db:studio",
    "db:reset": "turbo db push --force-reset",
    "postgres": "docker compose up postgres -d",
    "postgres:stop": "docker compose stop postgres"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@9.15.0"
}
