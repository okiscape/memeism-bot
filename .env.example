# ============================================
# Kisa Monorepo - Environment Variables
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For Docker: docker compose up
# For local:  ./dev.sh
# ============================================

# --- Discord Bot ---
BOT_TOKEN=
BOT_OWNER_ID=
DEV_GUILD_ID=
FEEDBACK_CHANNEL_ID=
PROFILE_EDITS_CHANNEL_ID=
SUPPORT_INVITE_URL=

# --- Discord OAuth2 (for dashboard login) ---
# Create at: https://discord.com/developers/applications
# OAuth2 -> General -> Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# --- PostgreSQL ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Backend ---
BACKEND_PORT=3001
DATABASE_URL=postgresql://kisa:change-me-in-production@localhost:5432/kisa

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=
FRONTEND_PORT=
