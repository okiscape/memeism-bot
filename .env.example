# ============================================
# Kisa Monorepo - Environment Variables
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For Docker: docker compose up
# For local:  ./dev.sh
# ============================================

# --- Discord Bot ---
BOT_TOKEN=your-bot-token-here
BOT_OWNER_ID=your-discord-user-id
DEV_GUILD_ID=your-dev-guild-id
FEEDBACK_CHANNEL_ID=your-feedback-channel-id
PROFILE_EDITS_CHANNEL_ID=your-profile-edits-channel-id
SUPPORT_INVITE_URL=https://discord.gg/your-invite

# --- Discord OAuth2 (for dashboard login) ---
# Create at: https://discord.com/developers/applications
# OAuth2 -> General -> Client ID / Client Secret
# Add redirect: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=your-client-id
DISCORD_CLIENT_SECRET=your-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback/discord
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- PostgreSQL (shared across all services) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Backend ---
BACKEND_PORT=3001
DATABASE_URL=postgresql://kisa:change-me-in-production@localhost:5432/kisa

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
